# LiveKit API credentials — must match relay/livekit.yaml keys.
# Generate: openssl rand -hex 16  /  openssl rand -hex 32
LIVEKIT_API_KEY=REPLACE_ME_API_KEY
LIVEKIT_API_SECRET=REPLACE_ME_API_SECRET_MIN_32_CHARS_LONG

# HMAC secret for Event-QR tokens (shared contract with the app, TASK-025).
# Generate: openssl rand -hex 32
EVENT_TOKEN_SECRET=REPLACE_ME_EVENT_TOKEN_SECRET_MIN_32_CHARS

# Optional overrides
# TOKEN_TTL_SECONDS=300
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_TTL_SECONDS=3600
# HOST=0.0.0.0
# PORT=8080
