# Keryx relay edge — TLS 1.3 to the LiveKit signaling port (TS §8.7).
# Caddy interpolates {$DOMAIN} / {$ACME_EMAIL} from the container env.
#
# /token is reserved for the FastAPI token service (TASK-003 / KRX-051).
# This compose does not run token-svc; the handle returns 503 until wired.

{
	email {$ACME_EMAIL}
	auto_https disable_redirects
	servers {
		protocols h1 h2
		strict_sni_host
	}
}

http://{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

https://{$DOMAIN} {
	tls {
		protocols tls1.3
	}

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	@token path /token /token/*
	handle @token {
		# Reserved route. Do not create token-svc files here (Owned_Paths: relay/**).
		respond "token-svc not wired" 503
	}

	handle {
		reverse_proxy 127.0.0.1:7880
	}

	log {
		output stdout
		format json
	}
}
