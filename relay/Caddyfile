# Keryx relay edge — TLS 1.3 to the LiveKit signaling port (TS §8.7).
# Caddy interpolates {$DOMAIN} / {$ACME_EMAIL} from the container env.
#
# /token is reserved for the FastAPI token service (TASK-003 / KRX-051).
# This compose does not run token-svc; the handle returns 503 until wired.

{
	email {$ACME_EMAIL}
	auto_https disable_redirects
	servers {
		protocols h1 h2
		strict_sni_host
	}
}

http://{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

https://{$DOMAIN} {
	tls {
		protocols tls1.3
	}

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	@token path /token /token/*
	handle @token {
		# TASK-040: token-svc (KRX-051) listens on loopback :8080 and is NOT a
		# compose service (no re-architecture of this stack). Caddy is the only
		# public mint path. Matches TASK-036's client convention:
		# wss://HOST → POST https://HOST/token (FastAPI route is also POST /token).
		reverse_proxy {$TOKEN_SVC_UPSTREAM}
	}

	handle {
		reverse_proxy 127.0.0.1:7880
	}

	log {
		output stdout
		format json
	}
}
