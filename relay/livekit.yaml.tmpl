# Rendered by scripts/render_config.py — do not commit the generated file.
# LiveKit SFU for Keryx LINKED mode (TS §8.4). Audio-only PTT rooms.
# Ingress/egress/recording are intentionally absent (TS §8.7).

port: 7880
bind_addresses:
  - "0.0.0.0"

rtc:
  port_range_start: ${LIVEKIT_RTC_PORT_START}
  port_range_end: ${LIVEKIT_RTC_PORT_END}
  tcp_port: 7881
  # CRITICAL — multi-homed host fix (see docs/INVESTIGATION_VOICE_COMM_FAILURE.md).
  # LiveKit runs `network_mode: host`, so Pion sees EVERY interface on the box:
  # eth0 (the public ${EXTERNAL_IP}), ~20 Docker bridges/veths from co-tenant
  # projects (172.16/12), and a Tailscale mesh iface (100.64/10 + fd7a::/48).
  # Left unpinned it advertised host ICE candidates on all of them; the ICE
  # agent then renominated the media pair onto a Docker/Tailscale address a
  # remote phone can never route to, and every session died within ~2s
  # (DTLS timeout → CLIENT_REQUEST_LEAVE). Three levers, together, make this
  # deterministic:
  #   - node_ip pins the single advertised address (this VPS binds the public
  #     IP directly to eth0 as /32 — there is NO NAT, so it is knowable);
  #   - use_external_ip: false stops the STUN pass that otherwise enumerates
  #     and maps EVERY interface (it exists to discover a NAT mapping we don't
  #     have — here it only re-introduced the bogus candidates);
  #   - ips.includes hard-restricts candidate gathering to the public /32,
  #     self-maintaining as co-tenant containers add/remove interfaces.
  # Reachability is unchanged: the public host candidate is directly routable,
  # and the bundled coturn (relay) remains the hostile-NAT path (NFR-05).
  node_ip: ${EXTERNAL_IP}
  use_external_ip: false
  ips:
    # CIDR is required (parsed as networks, not bare IPs — a bare address fails
    # config load with "invalid CIDR address"). /32 = exactly the one host IP.
    includes:
      - ${EXTERNAL_IP}/32
  allow_tcp_fallback: true
  # Packet buffer sized for audio PTT, not video conferencing.
  packet_buffer_size_audio: 200
  packet_buffer_size_video: 0
  use_mdns: false
  stun_servers:
    - stun.l.google.com:19302
  # Bundled coturn (TS §8.4) — hostile-NAT path toward NFR-05 ≥ 97%.
  # Shared secret must match turnserver.conf static-auth-secret.
  turn_servers:
    - host: ${TURN_DOMAIN}
      port: 3478
      protocol: udp
      secret: ${TURN_SHARED_SECRET}
    - host: ${TURN_DOMAIN}
      port: 3478
      protocol: tcp
      secret: ${TURN_SHARED_SECRET}
    - host: ${TURN_DOMAIN}
      port: 5349
      protocol: tls
      secret: ${TURN_SHARED_SECRET}

redis:
  address: 127.0.0.1:6379

keys:
  "${LIVEKIT_API_KEY}": "${LIVEKIT_API_SECRET}"

logging:
  level: info
  pion_level: error
  json: true
  sample: true

room:
  auto_create: true
  empty_timeout: 300
  departure_timeout: 20
  enabled_codecs:
    - mime: audio/opus
  max_participants: 64

# No webhook: nothing to persist, nothing to notify.
# No prometheus_port: do not expose metrics on the public interface.
# No ingress / egress blocks: recording and RTMP ingest stay off.

limit:
  subscription_limit_audio: 32
  subscription_limit_video: 0
