# Keryx relay — copy to `.env` and replace every REPLACE_ME / example value.
# No real secrets belong in git. `docker compose` interpolates from this file.
# Render runtime configs with:  python scripts/render_config.py --env .env

# --- Identity / DNS ----------------------------------------------------------
# Primary signaling hostname (Caddy TLS 1.3 + reverse-proxy to LiveKit :7880).
DOMAIN=relay.example.com
# TURN hostname advertised to clients. Must be a DNS A/AAAA on the same VPS.
TURN_DOMAIN=turn.example.com
# Let's Encrypt / ZeroSSL account email for Caddy automatic certs.
ACME_EMAIL=admin@example.com

# Public IPv4 of this VPS, used by coturn as external-ip (no STUN auto-detect
# in the default coturn config — set this explicitly).
# Use a documentation address (TEST-NET-3) only in this example file.
EXTERNAL_IP=203.0.113.10

# --- LiveKit API keys (token-svc will mint JWTs with these) ------------------
# Generate with: openssl rand -hex 16   /   openssl rand -hex 32
LIVEKIT_API_KEY=REPLACE_ME_API_KEY
LIVEKIT_API_SECRET=REPLACE_ME_API_SECRET_MIN_32_CHARS_LONG

# --- coturn shared secret (must match livekit.yaml turn_servers.secret) ------
# Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=REPLACE_ME_TURN_SHARED_SECRET_MIN_32_CHARS
TURN_REALM=turn.example.com

# --- Optional overrides (defaults match compose comments) --------------------
# LiveKit RTC UDP range (must be open on the host firewall).
LIVEKIT_RTC_PORT_START=50000
LIVEKIT_RTC_PORT_END=50200
# coturn relay UDP range — MUST NOT overlap the LiveKit RTC range.
COTURN_MIN_PORT=52000
COTURN_MAX_PORT=52999
